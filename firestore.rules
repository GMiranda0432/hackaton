rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // PACIENTES (BEM-TE-VER)
    match /users/{userId}/patients/{patientId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && incoming().userId == userId
                    && incoming().firstName is string && incoming().firstName.size() > 0 && incoming().firstName.size() <= 100
                    && incoming().lastName is string && incoming().lastName.size() > 0 && incoming().lastName.size() <= 100
                    && incoming().status is string && incoming().status.size() > 0 && incoming().status.size() <= 50;
      allow update: if isOwner(userId)
                    && incoming().userId == userId
                    && incoming().firstName is string && incoming().firstName.size() > 0 && incoming().firstName.size() <= 100
                    && incoming().lastName is string && incoming().lastName.size() > 0 && incoming().lastName.size() <= 100
                    && incoming().status is string && incoming().status.size() > 0 && incoming().status.size() <= 50;
      allow delete: if isOwner(userId);

      // BLOCO DE NOTAS / EVOLUÇÃO DIÁRIA DO PACIENTE
      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                      && incoming().userId == userId
                      && incoming().patientId == patientId
                      && incoming().content is string && incoming().content.size() > 0
                      && incoming().sessionDate is string;
        allow update: if isOwner(userId)
                      && incoming().userId == userId
                      && incoming().patientId == patientId
                      && incoming().content is string && incoming().content.size() > 0;
        allow delete: if isOwner(userId);
      }
    }

    // AGENDAMENTOS / CALENDÁRIO
    match /users/{userId}/appointments/{appointmentId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && incoming().userId == userId
                    && incoming().patientName is string && incoming().patientName.size() > 0
                    && incoming().date is string && incoming().date.size() > 0
                    && incoming().time is string && incoming().time.size() > 0
                    && incoming().status is string && incoming().status.size() > 0 && incoming().status.size() <= 50;
      allow update: if isOwner(userId)
                    && incoming().userId == userId
                    && incoming().patientName is string && incoming().patientName.size() > 0
                    && incoming().date is string && incoming().date.size() > 0
                    && incoming().time is string && incoming().time.size() > 0
                    && incoming().status is string && incoming().status.size() > 0 && incoming().status.size() <= 50;
      allow delete: if isOwner(userId);
    }

    // AVALIAÇÕES DE HUMOR E ESCALAS CLÍNICAS (PHQ-9, GAD-7, ETC)
    match /users/{userId}/assessments/{assessmentId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && incoming().userId == userId
                    && incoming().scaleType is string && incoming().scaleType.size() > 0
                    && incoming().score is int
                    && incoming().severity is string
                    && incoming().date is string;
      allow update: if isOwner(userId)
                    && incoming().userId == userId;
      allow delete: if isOwner(userId);
    }
  }
}
